{
  "name": "ch-ish",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Coffee House Angren — barista hiring Telegram mini app and manager panel",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist-server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/antonio": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "express": "^4.21.2",
    "grammy": "^1.35.0",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "lucide-react": "^0.462.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
