# Token of the NEW hiring bot from @BotFather (not the loyalty bot).
# For local development use a separate test bot, not the production one.
BOT_TOKEN=1234567890:AA...

# Public HTTPS address where this app is deployed (no trailing slash).
# https → bot runs as a webhook (production); http://localhost → long polling (dev).
PUBLIC_URL=https://ish.coffeehouseangren.uz

# Main admin password for the panel (PUBLIC_URL/admin, login "admin") — use a long one.
# Change it here and redeploy to reset it. HR accounts are created inside the panel.
ADMIN_PASSWORD=change-me

# Random string for signing login cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-too

# Optional: Telegram chat/group ID that gets a ping for every new application.
# Add the bot to the group, then use the group's ID (starts with -100…).
MANAGER_CHAT_ID=

# SQLite file. Leave unset in Coolify/Docker — it defaults to /data/ish.db there,
# which must be on a persistent volume mounted at /data. Uncomment only for local dev.
# DB_PATH=./data/ish.db

PORT=3000
